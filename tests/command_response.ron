            // the flags follow the value, so setting the default again restores them
            ResetRetryCounter(puk: "0102030405060708", new_pin: "313233343536FFFF"),
            IoData(
                input: "00 F7 00 80 00",
                output: Data("01 01 FF 05 01 01 06 02 03 03"),
            ),
            ResetRetryCounter(puk: "0102030405060708", new_pin: "3132333435363738"),
            IoData(
                input: "00 F7 00 80 00",
                output: Data("01 01 FF 05 01 00 06 02 03 03"),
            ),
            ChangePuk(
                old: "0102030405060708",
                new: "3132333435363738",
