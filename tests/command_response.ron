                input: "5C 03 5FC10C",
                output: Data("53 08 C1 01 01 C2 01 00 FE 00"),
            ),
        ]
    ),
    IoTest(
        name: "Malformed pin burns a retry",
        cmd_resp: [
            // eight 0xFF bytes can never match, but count like a wrong pin
            VerifyApplicationPin(pin: "FFFFFFFFFFFFFFFF", expected_status: RemainingRetries(2)),
            VerifyApplicationPin(pin: "FFFFFFFFFFFFFFFF", expected_status: RemainingRetries(1)),
            // the correct pin still verifies and resets the counter
            VerifyApplicationPin(),
            VerifyApplicationPin(pin: "FFFFFFFFFFFFFFFF", expected_status: RemainingRetries(2)),
        ]
    ),
