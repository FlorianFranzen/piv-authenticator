    IoTest(
        name: "Select resets the security state",
        cmd_resp: [
            VerifyApplicationPin(),
            // VERIFY with no data reports success while the pin is verified
            IoData(input: "00 20 00 80"),
            AuthenticateManagement(
                key: (
                    algorithm: Tdes,
                    key: "0102030405060708 0102030405060708 0102030405060708"
                ),
                mutual: false,
            ),
            Select,
            // after re-selecting, the pin is no longer verified
            IoData(input: "00 20 00 80", expected_status: RemainingRetries(3)),
            // and the management authentication is gone too
            PutData(
                input: "5C 01 7E 53 10 000102030405060708090A0B0C0D0E0F",
                expected_status: SecurityStatusNotSatisfied,
            ),
        ]
    ),
    IoTest(
        name: "Change reference data reports remaining retries",
        cmd_resp: [
            ChangePuk(old: "3131313131313131", new: "0102030405060708", expected_status: RemainingRetries(4)),
            ChangePin(old: "3131313131313131", new: "313131313131FFFF", expected_status: RemainingRetries(2)),
            ChangePin(old: "3131313131313131", new: "313131313131FFFF", expected_status: RemainingRetries(1)),
            ChangePin(old: "3131313131313131", new: "313131313131FFFF", expected_status: OperationBlocked),
            // once blocked, even the correct pin is refused
            ChangePin(new: "313131313131FFFF", expected_status: OperationBlocked),
        ]
    ),
    IoTest(
        name: "Key history stays absent while empty",
        cmd_resp: [
            GetData(
                input: "5C 03 5FC10C",
