            AuthenticateManagement(
                key: (
                    algorithm: Tdes,
                    key: "0102030405060708 0102030405060708 0102030405060708"
                ),
                mutual: false,
            ),
            // with a certificate stored for a retired slot, the object appears
            PutData(
                input: "5C 03 5FC10D 53 04 DEADBEEF",
